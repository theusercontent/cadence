{
  "name": "cadence",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Cadence — an offline-first task manager for focused teams.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/theusercontent/cadence.git"
  },
  "homepage": "https://github.com/theusercontent/cadence",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --port 4173",
    "start": "node scripts/serve.mjs",
    "prod": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:offline": "npm run build && node scripts/package-offline.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
