{
  "name": "Cadence — Work, in focus.",
  "short_name": "Cadence",
  "description": "An offline-first task manager for focused teams. Your work, remembered locally.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
